<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard de Gastos</title>
    <script src="static/tailwind-play.js"></script>
    <style>
        body { font-family: system-ui, -apple-system, sans-serif; }
        .hide-scroll::-webkit-scrollbar { display: none; }
        .hide-scroll { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen pb-10">
    <div class="max-w-6xl mx-auto px-4 pt-8">
        <!-- R1: Titulo -->
        <header class="mb-6 flex justify-between items-end border-b border-slate-200 pb-4">
            <div>
                <h1 class="text-2xl font-bold tracking-tight text-slate-800">Dashboard Financiero</h1>
                <p class="text-sm text-slate-500">Resumen mensual de movimientos</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-slate-400 uppercase tracking-wider">Total a Pagar</p>
                <p class="text-3xl font-bold text-slate-900">${{ "{:,.2f}".format(total_net_calc) }}</p>
            </div>
        </header>

        <!-- R2: Widgets Compactos -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-between">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Adeudo Anterior</p>
                <p class="text-lg font-bold text-slate-700">${{ "{:,.2f}".format(previous_balance) }}</p>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-between">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Cargos Mes</p>
                <p class="text-lg font-bold text-rose-600">${{ "{:,.2f}".format(total_charges) }}</p>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-between">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Mensualidades</p>
                <p class="text-lg font-bold text-rose-500">${{ "{:,.2f}".format(total_msi) }}</p>
            </div>
            <div class="bg-white p-4 rounded-xl shadow-sm border border-slate-100 flex flex-col justify-between">
                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Pagos / Abonos</p>
                <p class="text-lg font-bold text-emerald-600">-${{ "{:,.2f}".format(total_payments) }}</p>
            </div>
        </div>

        <!-- R3: Tabs Control -->
        <div class="mb-6 flex justify-between items-center flex-wrap gap-4 border-b border-slate-200 pb-3">
            <div class="bg-slate-100 p-1 rounded-xl flex space-x-1">
                <button id="tab-btn-categories" onclick="switchTab('categories')" class="px-5 py-2 text-xs font-bold rounded-lg transition-all duration-200 bg-white text-slate-800 shadow-sm">
                    Categorías
                </button>
                <button id="tab-btn-concepts" onclick="switchTab('concepts')" class="px-5 py-2 text-xs font-bold rounded-lg transition-all duration-200 text-slate-500 hover:text-slate-800">
                    Conceptos
                </button>
            </div>
        </div>

        <!-- Tab Panel: Categorías -->
        <div id="tab-panel-categories" class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead class="bg-slate-50 text-xs text-slate-500 uppercase font-semibold tracking-wider">
                        <tr>
                            <th class="px-6 py-4">Categoría</th>
                            <th class="px-6 py-4 text-right">%</th>
                            <th class="px-6 py-4 text-right">Monto</th>
                            <th class="px-6 py-4 text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        {% for row in table_rows %}
                        <tr class="hover:bg-slate-50/80 cursor-pointer group transition-colors" onclick="openModal('{{ row.cat }}')">
                            <td class="px-6 py-4">
                                <div class="flex items-center space-x-3">
                                    <div class="w-3 h-3 rounded-full ring-4 ring-white shadow-sm" style="background-color: {{ row.color }}"></div>
                                    <span class="font-semibold text-slate-700 text-sm group-hover:text-indigo-900 transition-colors">{{ row.cat }} <span class="text-xs text-slate-400 font-normal">({{ row.count }} movs)</span></span>
                                </div>
                            </td>
                            <td class="px-6 py-4 text-right text-xs text-slate-500 font-mono font-medium">
                                {%- if row.pct > 0 -%}
                                {{ "%.1f"|format(row.pct) }}%
                                {%- else -%}
                                -
                                {%- endif -%}
                            </td>
                            <td class="px-6 py-4 text-right font-mono text-sm font-bold {{ 'text-rose-600' if row.total > 0 else 'text-emerald-600' }}">
                                ${{ "{:,.2f}".format(row.total) }}
                            </td>
                            <td class="px-6 py-4 text-center" onclick="event.stopPropagation()">
                                <button onclick="copyToClipboard('{{ "{:.2f}".format(row.total) }}')"
                                        class="inline-flex items-center justify-center p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all"
                                        title="Copiar monto">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                                </button>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Tab Panel: Conceptos -->
        <div id="tab-panel-concepts" class="hidden">
            <!-- Buscador de conceptos -->
            <div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 bg-white p-4 rounded-2xl border border-slate-100 shadow-sm">
                <div class="relative flex-1 max-w-md">
                    <span class="absolute inset-y-0 left-0 flex items-center pl-3 pointer-events-none text-slate-400">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></span-->
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </span>
                    <input type="text" id="concept-search" oninput="filterConcepts()" placeholder="Buscar por concepto..." class="w-full pl-9 pr-8 py-2 text-sm bg-slate-50 text-slate-800 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all">
                    <button id="clear-search-btn" onclick="clearSearch()" class="absolute inset-y-0 right-0 flex items-center pr-3 text-slate-400 hover:text-slate-600 hidden">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </button>
                </div>
                <div>
                    <span id="search-count" class="bg-indigo-50 text-indigo-700 text-xs font-semibold px-3 py-1.5 rounded-lg border border-indigo-100">
                        Cargando...
                    </span>
                </div>
            </div>

            <!-- Tabla de todos los conceptos -->
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                <div class="overflow-x-auto max-h-[600px] overflow-y-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="bg-slate-50 sticky top-0 z-10 text-xs text-slate-500 uppercase font-semibold tracking-wider">
                            <tr>
                                <th class="px-6 py-4">Fecha</th>
                                <th class="px-6 py-4">Concepto</th>
                                <th class="px-6 py-4">Categoría</th>
                                <th class="px-6 py-4">Tipo</th>
                                <th class="px-6 py-4 text-right">Monto</th>
                                <th class="px-6 py-4 text-center">Copiar</th>
                            </tr>
                        </thead>
                        <tbody id="concepts-table-body" class="divide-y divide-slate-100">
                            {% for item in all_transactions %}
                            <tr class="concept-row hover:bg-slate-50/80 transition-colors" data-desc="{{ item.description }}">
                                <td class="px-6 py-4 text-slate-500 text-xs font-mono whitespace-nowrap">
                                    {{ item.date }}
                                </td>
                                <td class="px-6 py-4 text-sm font-semibold text-slate-700">
                                    {{ item.description }}
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% set cat_color = category_colors[item.category] or '#cbd5e1' %}
                                    <span class="inline-flex items-center space-x-1.5 px-2.5 py-1 rounded-full text-xs font-semibold" style="background-color: {{ cat_color }}22; color: {{ cat_color }}">
                                        <span class="w-1.5 h-1.5 rounded-full" style="background-color: {{ cat_color }}"></span>
                                        <span>{{ item.category }}</span>
                                    </span>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    {% if item.type == 'charge' %}
                                    <span class="px-2 py-1 bg-slate-100 text-slate-700 rounded-lg text-xs font-medium border border-slate-200">Cargo</span>
                                    {% elif item.type == 'msi' %}
                                    <span class="px-2 py-1 bg-purple-50 text-purple-700 rounded-lg text-xs font-medium border border-purple-100">MSI</span>
                                    {% elif item.type == 'refund' %}
                                    <span class="px-2 py-1 bg-teal-50 text-teal-700 rounded-lg text-xs font-medium border border-teal-100">Reembolso</span>
                                    {% elif item.type == 'payment' or item.type == 'prepayment' %}
                                    <span class="px-2 py-1 bg-emerald-50 text-emerald-700 rounded-lg text-xs font-medium border border-emerald-100">Pago</span>
                                    {% else %}
                                    <span class="px-2 py-1 bg-slate-50 text-slate-600 rounded-lg text-xs font-medium">{{ item.type }}</span>
                                    {% endif %}
                                </td>
                                <td class="px-6 py-4 text-right font-mono text-sm font-bold whitespace-nowrap {{ 'text-rose-600' if item.amount > 0 else 'text-emerald-600' }}">
                                    ${{ "{:,.2f}".format(item.amount) }}
                                </td>
                                <td class="px-6 py-4 text-center whitespace-nowrap">
                                    <button onclick="copyToClipboard('{{ "{:.2f}".format(item.amount) }}')"
                                            class="inline-flex items-center justify-center p-1.5 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition-all"
                                            title="Copiar monto">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                                    </button>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Hidden Data Containers for Modal -->
    {% for cat, items in category_items.items() %}
    <div id="data-{{ cat }}" class="hidden">
        {% for item in items | sort(attribute='amount', reverse=True) %}
        <div class="flex justify-between items-center py-2 border-b border-slate-50 last:border-0 hover:bg-slate-50 px-2 rounded">
            <div class="flex flex-col">
                <span class="text-xs text-slate-400 font-mono">{{ item.date }}</span>
                <span class="text-sm text-slate-700 font-medium">{{ item.description }}</span>
            </div>
            <span class="font-mono text-sm font-bold {{ 'text-rose-600' if item.amount > 0 else 'text-emerald-600' }}">
                ${{ "{:,.2f}".format(item.amount) }}
            </span>
        </div>
        {% endfor %}
    </div>
    {% endfor %}

    <!-- Modal Backdrop -->
    <div id="modal-backdrop" class="fixed inset-0 bg-slate-900/20 backdrop-blur-sm z-40 hidden transition-opacity opacity-0" onclick="closeModal()"></div>

    <!-- Modal Content -->
    <div id="modal-panel" class="fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white w-full max-w-lg rounded-2xl shadow-2xl z-50 hidden transition-all scale-95 opacity-0 overflow-hidden flex flex-col max-h-[80vh]">

        <div class="px-6 py-4 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
            <h3 id="modal-title" class="text-lg font-bold text-slate-800">Detalles</h3>
            <button onclick="closeModal()" class="text-slate-400 hover:text-slate-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
        </div>
        <div id="modal-body" class="p-6 overflow-y-auto flex-1">
            <!-- Content Injected via JS -->
        </div>
    </div>

    <!-- Toast Notification -->
    <div id="toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-slate-900 text-white px-4 py-2 rounded-full text-xs font-medium shadow-2xl opacity-0 translate-y-4 transition-all duration-300 pointer-events-none flex items-center space-x-2 z-50">
        <svg class="w-3 h-3 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
        <span id="toast-msg">Copiado</span>
    </div>

    <script>
        const scrollLockClass = 'overflow-hidden';
        const backdrop = document.getElementById('modal-backdrop');
        const panel = document.getElementById('modal-panel');
        const title = document.getElementById('modal-title');
        const body = document.getElementById('modal-body');

        function openModal(category) {
            const content = document.getElementById('data-' + category).innerHTML;
            title.textContent = category;
            body.innerHTML = content;

            backdrop.classList.remove('hidden');
            panel.classList.remove('hidden');

            requestAnimationFrame(() => {
                backdrop.classList.remove('opacity-0');
                panel.classList.remove('scale-95', 'opacity-0');
            });

            document.body.classList.add(scrollLockClass);
        }

        function closeModal() {
            backdrop.classList.add('opacity-0');
            panel.classList.add('scale-95', 'opacity-0');

            setTimeout(() => {
                backdrop.classList.add('hidden');
                panel.classList.add('hidden');
                document.body.classList.remove(scrollLockClass);
            }, 200);
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });

        function switchTab(tabId) {
            const btnCategories = document.getElementById('tab-btn-categories');
            const btnConcepts = document.getElementById('tab-btn-concepts');
            const panelCategories = document.getElementById('tab-panel-categories');
            const panelConcepts = document.getElementById('tab-panel-concepts');

            if (tabId === 'categories') {
                btnCategories.classList.add('bg-white', 'text-slate-800', 'shadow-sm');
                btnCategories.classList.remove('text-slate-500', 'hover:text-slate-800');
                btnConcepts.classList.remove('bg-white', 'text-slate-800', 'shadow-sm');
                btnConcepts.classList.add('text-slate-500', 'hover:text-slate-800');

                panelCategories.classList.remove('hidden');
                panelConcepts.classList.add('hidden');
            } else {
                btnConcepts.classList.add('bg-white', 'text-slate-800', 'shadow-sm');
                btnConcepts.classList.remove('text-slate-500', 'hover:text-slate-800');
                btnCategories.classList.remove('bg-white', 'text-slate-800', 'shadow-sm');
                btnCategories.classList.add('text-slate-500', 'hover:text-slate-800');

                panelConcepts.classList.remove('hidden');
                panelCategories.classList.add('hidden');
                filterConcepts();
            }
        }

        const normalizeText = (text) => {
            return text
                .toLowerCase()
                .normalize("NFD")
                .replace(/[\u0300-\u036f]/g, "");
        };

        function filterConcepts() {
            const searchInput = document.getElementById('concept-search');
            const clearBtn = document.getElementById('clear-search-btn');
            const countBadge = document.getElementById('search-count');
            const query = normalizeText(searchInput.value.trim());

            if (query.length > 0) {
                clearBtn.classList.remove('hidden');
            } else {
                clearBtn.classList.add('hidden');
            }

            const rows = document.querySelectorAll('.concept-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const desc = normalizeText(row.getAttribute('data-desc') || '');
                if (desc.includes(query)) {
                    row.classList.remove('hidden');
                    visibleCount++;
                } else {
                    row.classList.add('hidden');
                }
            });

            countBadge.textContent = `Mostrando ${visibleCount} de ${rows.length} conceptos`;
        }

        function clearSearch() {
            const searchInput = document.getElementById('concept-search');
            searchInput.value = '';
            filterConcepts();
            searchInput.focus();
        }

        // Initialize count when page loads
        document.addEventListener('DOMContentLoaded', () => {
            filterConcepts();
        });

        function copyToClipboard(text) {
            navigator.clipboard.writeText(text).then(() => {
                showToast(`Monto copiado: $${text}`);
            });
        }

        function showToast(msgText) {
            const toast = document.getElementById('toast');
            const msg = document.getElementById('toast-msg');
            msg.textContent = msgText;
            toast.classList.remove('opacity-0', 'translate-y-4');
            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-4');
            }, 2000);
        }
    </script>
</body>
</html>
